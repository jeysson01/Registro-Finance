# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# El cliente del navegador reutiliza estas dos (también puedes definirlas como NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — modelo de visión para leer el voucher
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# URL pública de la app (HTTPS en producción; el share target de Android lo exige)
NEXT_PUBLIC_APP_URL=http://localhost:3000
